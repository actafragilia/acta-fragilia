---
import "../styles/global.css";
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  lang?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  author?: string;
  section?: string;
  canonical?: string;
}

const {
  title,
  lang = 'ru',
  description,
  image = '/og/default.png',
  type = 'website',
  publishedTime,
  author,
  section,
  canonical,
} = Astro.props;

const nav = {
  ru: { materials: 'Материалы', about: 'О проекте', contacts: 'Контакты', archive: 'Архив' },
  en: { materials: 'Materials', about: 'About', contacts: 'Contacts', archive: 'Archive' },
  pl: { materials: 'Materiały', about: 'O projekcie', contacts: 'Kontakt', archive: 'Archiwum' },
  by: { materials: 'Матэрыялы', about: 'Пра праект', contacts: 'Кантакты', archive: 'Архіў' },
};

const footer = {
  ru: { privacy: 'Политика конфиденциальности', rights: 'Независимая журналистика' },
  en: { privacy: 'Privacy Policy', rights: 'Independent Journalism' },
  pl: { privacy: 'Polityka prywatności', rights: 'Niezależne dziennikarstwo' },
  by: { privacy: 'Палітыка прыватнасці', rights: 'Незалежная журналістыка' },
};

const defaultDescriptions: Record<string, string> = {
  ru: 'Независимая журналистика и анализ: право, экономика, корпоративные конфликты и общественные процессы.',
  en: 'Independent journalism and analysis: law, economics, corporate conflicts and social processes.',
  pl: 'Niezależne dziennikarstwo i analiza: prawo, gospodarka, konflikty korporacyjne i procesy społeczne.',
  by: 'Незалежная журналістыка і аналіз: права, эканоміка, карпаратыўныя канфлікты і грамадскія працэсы.',
};

const locales: Record<string, string> = {
  ru: 'ru_RU',
  en: 'en_US',
  pl: 'pl_PL',
  by: 'be_BY',
};

const t = nav[lang] || nav.ru;
const f = footer[lang] || footer.ru;
const prefix = lang === 'ru' ? '' : `/${lang}`;
const htmlLang = lang === 'by' ? 'be' : lang;
const metaDescription = description || defaultDescriptions[lang] || defaultDescriptions.ru;
const siteUrl = Astro.site ?? new URL('https://acta-fragilia.pages.dev');
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const publishedIso = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const currentLocale = locales[lang] || locales.ru;
const alternateLocales = Object.values(locales).filter((locale) => locale !== currentLocale);
---
<!DOCTYPE html>
<html lang={htmlLang} prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  {author && <meta name="author" content={author} />}
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:site_name" content="ACTA FRAGILIA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={currentLocale} />
  {alternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:secure_url" content={imageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  {type === 'article' && publishedIso && <meta property="article:published_time" content={publishedIso} />}
  {type === 'article' && section && <meta property="article:section" content={section} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={title} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
  <link
    rel="alternate"
    type="application/rss+xml"
    title="ACTA FRAGILIA RSS"
    href={`${prefix}/rss.xml`}
  />
<<style is:global>
  /* === БАЗОВЫЙ СБРОС === */
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #fafafa;
    color: #1a1a1a;
    line-height: 1.7;
    padding: 0 1rem;
  }

  .container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 0;
  }

  /* === ШАПКА === */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 1.2rem 0;
    border-bottom: 2px solid #eaeaea;
    margin-bottom: 2rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .logo {
    font-family: 'Source Serif 4', 'Merriweather', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: -0.5px;
    margin-right: auto;
  }
  .logo:hover { color: #3d5a80; }

  .main-nav {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .main-nav a {
    color: #333;
    text-decoration: none;
    transition: color 0.2s;
  }
  .main-nav a:hover { color: #3d5a80; }

  /* Переключатель языков (встроенный в навигацию) */
  .lang-switcher {
    display: flex;
    gap: 0.3rem;
    font-weight: 600;
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }
  .lang-switcher a {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #888;
    text-decoration: none;
    transition: 0.2s;
  }
  .lang-switcher a:hover {
    background: #eee;
    color: #222;
  }
  .lang-switcher a.active {
    background: #3d5a80;
    color: white;
  }

  /* === ГЕРОЙ (если есть) === */
  .hero {
    text-align: center;
    padding: 2rem 0 1.5rem;
  }
  .hero h1 {
    font-family: 'Source Serif 4', 'Merriweather', serif;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .hero .subtitle {
    font-size: 1.2rem;
    color: #555;
    max-width: 600px;
    margin: 0 auto 1.2rem;
  }
  .hero .tags {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    font-size: 0.9rem;
    color: #777;
    flex-wrap: wrap;
  }
  .hero .tags span {
    background: #eee;
    padding: 0.2rem 1rem;
    border-radius: 20px;
  }

  /* === КАРТОЧКИ СТАТЕЙ === */
  /* Применяется ко всем article, section, .post-card внутри main */
  main article,
  main section,
  .post-card {
    background: white;
    border-radius: 12px;
    padding: 1.8rem 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid #f0f0f0;
    transition: box-shadow 0.2s, transform 0.15s;
  }
  main article:hover,
  main section:hover,
  .post-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.10);
    transform: translateY(-2px);
  }

  .post-card .category,
  main article .category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #3d5a80;
    margin-bottom: 0.3rem;
  }
  .post-card .date,
  main article .date {
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 0.5rem;
  }
  .post-card h2,
  main article h2 {
    font-family: 'Source Serif 4', 'Merriweather', serif;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .post-card h2 a,
  main article h2 a {
    color: #1a1a1a;
    text-decoration: none;
  }
  .post-card h2 a:hover,
  main article h2 a:hover {
    color: #3d5a80;
  }
  .post-card p,
  main article p {
    color: #444;
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .post-card .read-more,
  main article .read-more {
    font-weight: 600;
    color: #3d5a80;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .post-card .read-more:hover,
  main article .read-more:hover {
    text-decoration: underline;
  }

  /* === ПОДВАЛ === */
  .site-footer {
    margin-top: 3rem;
    padding: 2rem 0 1.5rem;
    border-top: 1px solid #eaeaea;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #777;
    text-align: center;
  }
  .footer-brand {
    font-family: 'Source Serif 4', 'Merriweather', serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #1a1a1a;
  }
  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer-links a {
    color: #3d5a80;
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .footer-copy {
    color: #999;
    font-size: 0.85rem;
  }

  /* === ТЁМНАЯ ТЕМА (автоматически) === */
  @media (prefers-color-scheme: dark) {
    body {
      background-color: #121212;
      color: #e8e8e8;
    }
    .site-header {
      border-bottom-color: #2a2a2a;
    }
    .logo {
      color: #e8e8e8;
    }
    .logo:hover { color: #4dabf7; }
    .main-nav a {
      color: #ccc;
    }
    .main-nav a:hover { color: #4dabf7; }
    .lang-switcher a {
      color: #999;
    }
    .lang-switcher a:hover {
      background: #2a2a2a;
      color: #eee;
    }
    .lang-switcher a.active {
      background: #4dabf7;
      color: #121212;
    }
    .hero .subtitle {
      color: #aaa;
    }
    .hero .tags span {
      background: #2a2a2a;
      color: #bbb;
    }
    main article,
    main section,
    .post-card {
      background: #1a1a1a;
      border-color: #2a2a2a;
      box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }
    main article:hover,
    main section:hover,
    .post-card:hover {
      box-shadow: 0 6px 24px rgba(0,0,0,0.5);
    }
    .post-card .category,
    main article .category {
      color: #4dabf7;
    }
    .post-card .date,
    main article .date {
      color: #888;
    }
    .post-card h2 a,
    main article h2 a {
      color: #e8e8e8;
    }
    .post-card h2 a:hover,
    main article h2 a:hover {
      color: #4dabf7;
    }
    .post-card p,
    main article p {
      color: #bbb;
    }
    .post-card .read-more,
    main article .read-more {
      color: #4dabf7;
    }
    .site-footer {
      border-top-color: #2a2a2a;
    }
    .footer-brand {
      color: #e8e8e8;
    }
    .footer-links a {
      color: #4dabf7;
    }
    .footer-copy {
      color: #888;
    }
  }

  /* === АДАПТИВ === */
  @media (max-width: 700px) {
    .site-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .header-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.8rem;
    }
    .logo {
      margin-right: 0;
      text-align: center;
    }
    .main-nav {
      justify-content: center;
      gap: 0.8rem;
    }
    .lang-switcher {
      margin-left: 0;
    }
    .hero h1 {
      font-size: 2rem;
    }
    main article,
    main section,
    .post-card {
      padding: 1.2rem;
    }
    main article h2,
    .post-card h2 {
      font-size: 1.3rem;
    }
    .footer-links {
      gap: 0.8rem;
    }
  }
</style>
</style>
</head>
<body>
  <header class="site-header">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <div class="container header-inner">
      <a href={`${prefix}/`} class="logo" aria-label="ACTA FRAGILIA">
        <span class="logo-mark" aria-hidden="true"></span>
        <span class="logo-text">ACTA FRAGILIA</span>
      </a>
      <a href={`${prefix}/archive`}>{t.archive}</a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href={`${prefix}/`}>{t.materials}</a>
        <a href={`${prefix}/about`}>{t.about}</a>
        <a href={`${prefix}/contacts`}>{t.contacts}</a>
        <LanguageSwitcher currentLang={lang} />
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">ACTA FRAGILIA</div>
      <div class="footer-links">
        <a href="mailto:acta_fragilia@proton.me">acta_fragilia@proton.me</a>
        <a href={`${prefix}/rss.xml`}>RSS</a>
        <a href={`${prefix}/privacy`}>{f.privacy}</a>
      </div>
      <div class="footer-copy">
        © 2026 ACTA FRAGILIA. {f.rights}.
      </div>
    </div>
  </footer>
</body>
</html>
