---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  lang?: string;
  description?: string;
}

const { title, lang = 'ru', description } = Astro.props;

const nav = {
  ru: { materials: 'Материалы', about: 'О проекте', contacts: 'Контакты', archive: 'Архив', pseudonym: 'О псевдониме' },
  en: { materials: 'Materials', about: 'About', contacts: 'Contacts', archive: 'Archive', pseudonym: 'About the pseudonym' },
  pl: { materials: 'Materiały', about: 'O projekcie', contacts: 'Kontakt', archive: 'Archiwum', pseudonym: 'O pseudonimie' },
  by: { materials: 'Матэрыялы', about: 'Пра праект', contacts: 'Кантакты', archive: 'Архіў', pseudonym: 'Пра псеўданім' },
};

const footer = {
  ru: { privacy: 'Политика конфиденциальности', rights: 'Независимая журналистика' },
  en: { privacy: 'Privacy Policy', rights: 'Independent Journalism' },
  pl: { privacy: 'Polityka prywatności', rights: 'Niezależne dziennikarstwo' },
  by: { privacy: 'Палітыка прыватнасці', rights: 'Незалежная журналістыка' },
};

const defaultDescriptions = {
  ru: 'ACTA FRAGILIA — независимое издание о политике, экономике и обществе.',
  be: 'ACTA FRAGILIA — незалежнае выданне пра палітыку, эканоміку і грамадства.',
  en: 'ACTA FRAGILIA — independent journalism on politics, economics, and society.',
  pl: 'ACTA FRAGILIA — niezależne dziennikarstwo o polityce, ekonomii i społeczeństwie.',
};

const ogLocales = { ru: 'ru_RU', be: 'be_BY', en: 'en_US', pl: 'pl_PL' };

const t = nav[lang] || nav.ru;
const f = footer[lang] || footer.ru;
const prefix = lang === 'ru' ? '' : `/${lang}`;
const htmlLang = lang === 'by' ? 'be' : lang;

const siteURL = 'https://acta-fragilia.pages.dev';
const pageURL = new URL(Astro.url.pathname, siteURL).href;
const metaDescription = description || defaultDescriptions[htmlLang] || defaultDescriptions.ru;
const ogLocale = ogLocales[htmlLang] || ogLocales.ru;
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageURL} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={`${siteURL}/og-image.png`} />
  <meta property="og:site_name" content="ACTA FRAGILIA" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={`${siteURL}/og-image.png`} />
  <link rel="canonical" href={pageURL} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Версионирование CSS для сброса кеша Cloudflare -->
  <link rel="stylesheet" href="/global.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href={`${prefix}/`} class="logo">ACTA FRAGILIA</a>
      <nav class="main-nav">
        <a href={`${prefix}/`}>{t.materials}</a>
        <a href={`${prefix}/archive`}>{t.archive}</a>
        <a href={`${prefix}/about`}>{t.about}</a>
        <a href={`${prefix}/contacts`}>{t.contacts}</a>
        <a href={`${prefix}/pseudonym`}>{t.pseudonym}</a>
        <LanguageSwitcher currentLang={lang} />
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">ACTA FRAGILIA</div>
      <div class="footer-links">
        <a href="mailto:acta_fragilia@proton.me">acta_fragilia@proton.me</a>
        <a href={`${prefix}/rss.xml`}>RSS</a>
        <a href={`${prefix}/privacy`}>{f.privacy}</a>
      </div>
      <div class="footer-copy">&copy; 2026 ACTA FRAGILIA. {f.rights}</div>
    </div>
  </footer>
</body>
</html>