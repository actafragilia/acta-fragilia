---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  lang?: string;
  description?: string;
}

const { title, lang = 'ru', description } = Astro.props;

const nav = {
  ru: { materials: 'Материалы', about: 'О проекте', contacts: 'Контакты', archive: 'Архив', pseudonym: 'О псевдониме', menu: 'Меню', theme: 'Сменить тему' },
  en: { materials: 'Materials', about: 'About', contacts: 'Contacts', archive: 'Archive', pseudonym: 'About the pseudonym', menu: 'Menu', theme: 'Toggle theme' },
  pl: { materials: 'Materiały', about: 'O projekcie', contacts: 'Kontakt', archive: 'Archiwum', pseudonym: 'O pseudonimie', menu: 'Menu', theme: 'Zmień motyw' },
  by: { materials: 'Матэрыялы', about: 'Пра праект', contacts: 'Кантакты', archive: 'Архіў', pseudonym: 'Пра псеўданім', menu: 'Меню', theme: 'Змяніць тэму' },
};

const footer = {
  ru: { privacy: 'Политика конфиденциальности', rights: 'Независимая журналистика', skip: 'К содержанию' },
  en: { privacy: 'Privacy Policy', rights: 'Independent Journalism', skip: 'Skip to content' },
  pl: { privacy: 'Polityka prywatności', rights: 'Niezależne dziennikarstwo', skip: 'Przejdź do treści' },
  by: { privacy: 'Палітыка прыватнасці', rights: 'Незалежная журналістыка', skip: 'Да зместу' },
};

const defaultDescriptions = {
  ru: 'ACTA FRAGILIA — независимое издание о политике, экономике и обществе.',
  be: 'ACTA FRAGILIA — незалежнае выданне пра палітыку, эканоміку і грамадства.',
  en: 'ACTA FRAGILIA — independent journalism on politics, economics, and society.',
  pl: 'ACTA FRAGILIA — niezależne dziennikarstwo o polityce, ekonomii i społeczeństwie.',
};

const ogLocales = { ru: 'ru_RU', be: 'be_BY', en: 'en_US', pl: 'pl_PL' };

const t = nav[lang] || nav.ru;
const f = footer[lang] || footer.ru;
const prefix = lang === 'ru' ? '' : `/${lang}`;
const htmlLang = lang === 'by' ? 'be' : lang;

const siteURL = 'https://acta-fragilia.pages.dev';
const pageURL = new URL(Astro.url.pathname, siteURL).href;
const metaDescription = description || defaultDescriptions[htmlLang] || defaultDescriptions.ru;
const ogLocale = ogLocales[htmlLang] || ogLocales.ru;
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#f0ece0" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageURL} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={`${siteURL}/og-image.svg`} />
  <meta property="og:site_name" content="ACTA FRAGILIA" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={`${siteURL}/og-image.svg`} />
  <link rel="canonical" href={pageURL} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/global.css" />
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">{f.skip}</a>
  <header class="site-header">
    <div class="header-inner">
      <a href={`${prefix}/`} class="logo">ACTA FRAGILIA</a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label={t.theme} title={t.theme}>
        <span class="theme-icon-light" aria-hidden="true">◐</span>
        <span class="theme-icon-dark" aria-hidden="true">◑</span>
      </button>
      <label for="nav-toggle" class="nav-burger" aria-label={t.menu}>
        <span></span><span></span><span></span>
      </label>
      <nav class="main-nav" aria-label="main">
        <a href={`${prefix}/`}>{t.materials}</a>
        <a href={`${prefix}/archive`}>{t.archive}</a>
        <a href={`${prefix}/about`}>{t.about}</a>
        <a href={`${prefix}/contacts`}>{t.contacts}</a>
        <a href={`${prefix}/pseudonym`}>{t.pseudonym}</a>
        <LanguageSwitcher currentLang={lang} />
      </nav>
    </div>
  </header>
  <main class="container" id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">ACTA FRAGILIA</div>
      <div class="footer-links">
        <a href="mailto:acta_fragilia@proton.me">acta_fragilia@proton.me</a>
        <a href={`${prefix}/rss.xml`}>RSS</a>
        <a href={`${prefix}/privacy`}>{f.privacy}</a>
      </div>
      <div class="footer-copy">&copy; 2026 ACTA FRAGILIA. {f.rights}</div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      var toggle = document.getElementById('nav-toggle');
      if (toggle) {
        document.querySelectorAll('.main-nav a').forEach(function (a) {
          a.addEventListener('click', function () { toggle.checked = false; });
        });
      }
    })();
  </script>
</body>
</html>