---
import "../styles/global.css";
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
// ... остальные импорты

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description = "Независимая авторская площадка для долгих текстов, анализа документов, расследований и объяснения сложных тем.", ogImage, canonical } = Astro.props;

const siteUrl = "https://acta-fragilia.pages.dev";
const fullTitle = title === "ACTA FRAGILIA" ? title : `${title} — ACTA FRAGILIA`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical || siteUrl}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ACTA FRAGILIA">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical || siteUrl}>
  {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  {ogImage && <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />}

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="ACTA FRAGILIA — RSS" href="/rss.xml">

  <slot name="head" />
</head>

<body>
  <nav class="site-nav">
    <div class="container">
      <div class="nav-logo">
        <a href="/">
          <span class="logo-mark" aria-hidden="true"></span>
          ACTA FRAGILIA
        </a>
      </div>
      <ul class="nav-links">
        <li><a href="/" class={Astro.url.pathname === "/" ? "active" : ""}>Материалы</a></li>
        <li><a href="/about">О проекте</a></li>
        <li><a href="/contacts">Контакты</a></li>
	<li> <LanguageSwitcher /></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer container">
    <div class="footer-inner">
      <div class="footer-brand">ACTA FRAGILIA</div>
      <ul class="footer-links">
        <li><a href="mailto:info@acta-fragilia.pages.dev">info@acta-fragilia.pages.dev</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/privacy">Политика конфиденциальности</a></li>
      </ul>
      <p class="footer-copy">© {new Date().getFullYear()} ACTA FRAGILIA. Независимая журналистика.</p>
    </div>
  </footer>
</body>
</html>
