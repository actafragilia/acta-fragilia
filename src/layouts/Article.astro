---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, subtitle, category, date, updated, author, readTime } = article.data;
const { Content } = await article.render();

const formattedDate = new Date(date).toLocaleDateString('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric'
});

const formattedUpdated = updated ? new Date(updated).toLocaleDateString('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric'
}) : null;
---

<Base
  title={title}
  description={subtitle}
  canonical={`https://acta-fragilia.pages.dev/article/${article.slug}`}
>
  <article>
    <header class="article-header container">
      <nav class="breadcrumbs" aria-label="Навигация">
        <a href="/">Материалы</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </nav>

      <span class="article-category">{category}</span>
      <h1>{title}</h1>
      <p class="article-subtitle">{subtitle}</p>

      <div class="article-meta-row">
        <span>Автор: {author}</span>
        <span class="divider" aria-hidden="true"></span>
        <time datetime={date.toISOString().split('T')[0]}>{formattedDate}</time>
        <span class="divider" aria-hidden="true"></span>
        <span>Время чтения: {readTime} мин</span>
        {formattedUpdated && (
          <>
            <span class="divider" aria-hidden="true"></span>
            <span>Обновлено: {formattedUpdated}</span>
          </>
        )}
      </div>
    </header>

    <div class="article-content container">
      <div class="article-layout">
        <div class="article-text">
          <Content />

          <div class="sources">
            <h3>Источники и ссылки</h3>
            <ol>
              {article.data.sources?.map((source: string) => (
                <li>{source}</li>
              )) || <li>Источники не указаны.</li>}
            </ol>
          </div>
        </div>

        <aside class="marginal-note" aria-label="Контекст">
          <strong>Контекст</strong>
          {article.data.marginalNote || "Дополнительный контекст к материалу."}
        </aside>
      </div>
    </div>
  </article>

  <aside class="read-more container">
    <h2>Читать далее</h2>
    <div class="read-more-grid">
      <a href="/" class="read-more-card">
        <span class="category">← Все материалы</span>
        <h4>Вернуться к списку публикаций</h4>
        <p>Другие материалы по праву, экономике и общественным процессам.</p>
      </a>
    </div>
  </aside>

  <style>
    .article-header { padding: var(--space-xl) 0 var(--space-lg); }
    .breadcrumbs {
      display: flex; align-items: center; gap: var(--space-xs);
      font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted);
      margin-bottom: var(--space-lg);
    }
    .breadcrumbs a:hover { color: var(--accent); }
    .article-category {
      display: inline-block;
      font-family: var(--font-mono); font-size: var(--step--1); font-weight: 500;
      color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em;
      margin-bottom: var(--space-sm);
    }
    .article-header h1 {
      font-family: var(--font-display); font-size: var(--step-3); font-weight: 600;
      line-height: 1.1; letter-spacing: -0.02em; max-width: 26ch; margin-bottom: var(--space-md);
    }
    .article-subtitle {
      font-family: var(--font-display); font-size: var(--step-1); font-weight: 400;
      line-height: 1.5; color: var(--muted); font-style: italic;
      max-width: 55ch; margin-bottom: var(--space-lg);
    }
    .article-meta-row {
      display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md);
      font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted);
      padding-top: var(--space-md); border-top: 1px solid var(--line);
    }
    .article-meta-row .divider { width: 1px; height: 1em; background: var(--line-strong); }

    .article-content { padding-bottom: var(--space-2xl); }
    .article-layout {
      display: grid;
      grid-template-columns: 1fr min(var(--text-width), 100%) 1fr;
      gap: var(--space-lg);
    }
    .article-text {
      grid-column: 2;
      font-family: var(--font-display); font-size: var(--step-0); line-height: 1.75;
    }
    .article-text > :global(* + *) { margin-top: var(--space-md); }
    .article-text :global(h2) {
      font-family: var(--font-display); font-size: var(--step-2); font-weight: 600;
      line-height: 1.2; letter-spacing: -0.01em;
      margin-top: var(--space-xl); margin-bottom: var(--space-sm);
    }
    .article-text :global(h3) {
      font-family: var(--font-ui); font-size: var(--step-1); font-weight: 600;
      line-height: 1.3; margin-top: var(--space-lg); margin-bottom: var(--space-xs); color: var(--muted);
    }
    .article-text :global(p) { max-width: var(--text-width); }
    .article-text :global(a) {
      color: var(--accent); text-decoration: underline;
      text-underline-offset: 0.2em; text-decoration-thickness: 1px;
    }
    .article-text :global(a:hover) { text-decoration-thickness: 2px; }

    .sources {
      margin-top: var(--space-xl); padding: var(--space-lg);
      background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    }
    .sources h3 {
      font-family: var(--font-mono); font-size: var(--step--1); font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.04em;
      margin-bottom: var(--space-md); color: var(--muted);
    }
    .sources ol {
      padding-left: var(--space-md);
      font-family: var(--font-ui); font-size: var(--step--1);
      color: var(--muted); line-height: 1.7;
    }
    .sources li { margin-bottom: var(--space-xs); padding-left: var(--space-xs); }

    .marginal-note {
      grid-column: 3; font-family: var(--font-mono); font-size: 0.8rem;
      line-height: 1.5; color: var(--muted);
      padding-top: var(--space-sm); border-top: 1px solid var(--line); align-self: start;
    }
    .marginal-note strong { display: block; color: var(--ink); font-weight: 500; margin-bottom: 0.2em; }

    .read-more { padding: var(--space-xl) 0; border-top: 1px solid var(--line-strong); }
    .read-more h2 {
      font-family: var(--font-mono); font-size: var(--step--1); font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: var(--space-lg);
    }
    .read-more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-lg); }
    .read-more-card {
      padding: var(--space-md); background: var(--surface);
      border: 1px solid var(--line); border-radius: var(--radius);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .read-more-card:hover { border-color: var(--line-strong); box-shadow: 0 4px 20px -8px color-mix(in oklab, var(--ink) 15%, transparent); }
    .read-more-card .category {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent);
      text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-xs); display: block;
    }
    .read-more-card h4 {
      font-family: var(--font-display); font-size: var(--step-1); font-weight: 600;
      line-height: 1.25; margin-bottom: var(--space-xs);
    }
    .read-more-card p {
      font-family: var(--font-ui); font-size: var(--step--1); color: var(--muted); line-height: 1.55;
    }

    @media (max-width: 768px) {
      .article-layout { grid-template-columns: 1fr; }
      .article-text { grid-column: 1; }
      .marginal-note {
        grid-column: 1; margin-top: var(--space-sm); padding: var(--space-sm);
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
      }
    }
  </style>
</Base>
