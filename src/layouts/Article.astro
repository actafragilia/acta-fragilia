---
const { title, category, date, author } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <main class="article-page">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Главная</a>
        <span class="breadcrumbs-separator">/</span>
        <a href="/archive/">Материалы</a>
        <span class="breadcrumbs-separator">/</span>
        <span>{category}</span>
        <span class="breadcrumbs-separator">/</span>
        <span class="breadcrumbs-current">{title}</span>
      </nav>

      <article>
        <header class="article-header">
          <p class="article-category">{category}</p>
          <h1>{title}</h1>
          <div class="article-meta">
            <span>{date}</span>
            <span class="author-monastic">◈ А. К.</span>
          </div>
        </header>
        <div class="article-content">
          <slot />
        </div>
      </article>

      <footer class="article-footer">
        <p class="author-monastic">◈ А. К.</p>
      </footer>
    </main>
  </body>
</html>

<style>
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
    margin-bottom: 1.5rem;
    padding: 0.5rem 0;
  }
  .breadcrumbs a {
    color: var(--color-link, #005a9c);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs-separator {
    margin: 0 0.4rem;
    color: var(--color-text-muted, #999);
  }
  .breadcrumbs-current {
    color: var(--color-text, #333);
    font-weight: 500;
  }
  .article-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
  }
  .article-category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #666);
    margin-bottom: 0.5rem;
  }
  .article-header h1 {
    font-size: 1.8rem;
    line-height: 1.3;
    margin: 0 0 1rem 0;
  }
  .article-meta {
    font-size: 0.9rem;
    color: var(--color-text-muted, #666);
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .article-content {
    line-height: 1.7;
    font-size: 1rem;
  }
  .article-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #e0e0e0);
    text-align: center;
  }
</style>
