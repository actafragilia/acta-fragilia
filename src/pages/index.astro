---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="ACTA FRAGILIA" description="Независимая авторская площадка для долгих текстов, анализа документов, расследований и объяснения сложных тем.">

  <!-- HERO -->
  <header class="hero">
    <div class="hero-grid" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <defs>
          <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="var(--line-strong)" stroke-width="0.8"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="var(--accent)" stroke-width="0.5" opacity="0.15"/>
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="var(--accent)" stroke-width="0.5" opacity="0.15"/>
      </svg>
    </div>
    <div class="container hero-content">
      <p class="hero-eyebrow">Независимая журналистика и анализ</p>
      <h1>ACTA <em>FRAGILIA</em></h1>
      <p class="hero-lead">Право, экономика, корпоративные конфликты и общественные процессы — без шума, с проверкой фактов и вниманием к последствиям.</p>
      <div class="hero-meta">
        <span><span class="dot" aria-hidden="true"></span> Долгие тексты</span>
        <span><span class="dot" aria-hidden="true"></span> Документы</span>
        <span><span class="dot" aria-hidden="true"></span> Расследования</span>
      </div>
    </div>
  </header>

  <!-- CATEGORIES -->
  <section class="container">
    <div class="section-header">
      <h2>Рубрики</h2>
      <span class="line" aria-hidden="true"></span>
    </div>
    <ul class="category-list home-categories">
      <li><a href="/archive?category=Право">Право</a> — Разбор законодательства, судебной практики и правовых коллизий.</li>
      <li><a href="/archive?category=Экономика">Экономика</a> — Анализ корпоративных конфликтов, банкротств, налоговых и финансовых механизмов.</li>
      <li><a href="/archive?category=Общество">Общество</a> — Социальные процессы, институты и их трансформация.</li>
      <li><a href="/archive?category=Медиа">Медиа</a> — Информационные потоки, журналистика и медиаграмотность.</li>
      <li><a href="/archive?category=Конфликт">Конфликт</a> — Корпоративные и экономические споры в деталях.</li>
      <li><a href="/archive?category=Документ">Документ</a> — Разбор одного конкретного документа с комментариями.</li>
    </ul>
  </section>

  <!-- ARTICLES LIST -->
  <section class="container">
    <div class="section-header">
      <h2>Последние публикации</h2>
      <span class="line" aria-hidden="true"></span>
    </div>

    <div class="articles-list">
      {articles.map(article => {
        const d = new Date(article.data.date);
        const dateStr = d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
        return (
          <article class="article-card">
            <div class="article-marginalia">
              <a href={`/archive?category=${article.data.category}`} class="article-category">{article.data.category}</a>
              <time class="article-date" datetime={d.toISOString().split('T')[0]}>{dateStr}</time>
            </div>
            <div class="article-body">
              <h3><a href={`/article/${article.slug}`}>{article.data.title}</a></h3>
              <p>{article.data.subtitle}</p>
              <a href={`/article/${article.slug}`} class="article-link">Читать полностью →</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
  </Base>