---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const articles = await getCollection('articlesBy');
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Архіў — ACTA FRAGILIA" lang="by">
  <div class="archive-page">
    <h1 class="archive-title">Архіў матэрыялаў</h1>

    <div class="filter-bar" role="group" aria-label="Фільтр па рубрыках">
      <button class="filter-btn active" data-filter="all" aria-pressed="true">Усе</button>
      <button class="filter-btn" data-filter="Эканоміка" aria-pressed="false">Эканоміка</button>
      <button class="filter-btn" data-filter="Грамадства" aria-pressed="false">Грамадства</button>
      <button class="filter-btn" data-filter="Медыя" aria-pressed="false">Медыя</button>
    </div>

    <div class="archive-list">
      {articles.map(article => (
        <article class="archive-item" data-category={article.data.category}>
          <div class="archive-meta">
            <span class="archive-category">{article.data.category}</span>
            <time class="archive-date">{article.data.date.toLocaleDateString('be-BE', {year:'numeric', month:'long', day:'numeric'})}</time>
          </div>
          <h2><a href={`/by/article/${article.slug}/`}>{article.data.title}</a></h2>
          <p>{article.data.subtitle}</p>
        </article>
      ))}
      <p class="archive-empty hidden" style="display: none;">Няма матэрыялаў у выбранай рубрыцы.</p>
    </div>
  </div>
</Base>


<script>
  (function() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.archive-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', function() {
        buttons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;

        let visibleCount = 0;
        items.forEach(item => {
          if (filter === 'all' || item.dataset.category === filter) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        const emptyMsg = document.querySelector('.archive-empty');
        if (emptyMsg) {
          emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
        }
      });
    });
  })();
</script>


<style>

  .archive-page {
    padding: var(--space-xl) 0;
    max-width: 960px;
    margin: 0 auto;
  }
  .archive-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }
  .filter-bar {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }
  .archive-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .archive-item {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }
  .archive-item.hidden {
    display: none;
  }
  .archive-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .archive-category {
    color: var(--color-accent);
    font-weight: 500;
  }
  .archive-date {
    color: var(--color-text-secondary);
  }
  .archive-item h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: var(--space-sm);
  }
  .archive-item h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .archive-item h2 a:hover {
    color: var(--color-accent);
  }
  .archive-item p {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .archive-empty {
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    font-style: italic;
    padding: var(--space-xl) 0;
  }
  @media (max-width: 768px) {
    .filter-bar {
      gap: var(--space-xs);
    }
    .filter-btn {
      padding: 0.35rem 0.6rem;
      font-size: 0.7rem;
    }
  }

</style>
