---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const articles = await getCollection('articlesBy');
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Архіў — ACTA FRAGILIA" lang="by">
  <div class="archive-page">
    <h1 class="archive-title">Архіў матэрыялаў</h1>

    <div class="filter-bar" role="group" aria-label="Фільтр па рубрыках">
      <button class="filter-btn active" data-filter="all" aria-pressed="true">Усе</button>
      <button class="filter-btn" data-filter="Эканоміка" aria-pressed="false">Эканоміка</button>
      <button class="filter-btn" data-filter="Грамадства" aria-pressed="false">Грамадства</button>
      <button class="filter-btn" data-filter="Медыя" aria-pressed="false">Медыя</button>
    </div>

    <div class="archive-list">
      {articles.map(article => (
        <article class="archive-item" data-category={article.data.category}>
          <div class="archive-meta">
            <span class="archive-category">{article.data.category}</span>
            <time class="archive-date">{article.data.date.toLocaleDateString('be-BY', {year:'numeric', month:'long', day:'numeric'})}</time>
          </div>
          <h2><a href={`/by/article/${article.slug}/`}>{article.data.title}</a></h2>
          <p>{article.data.subtitle}</p>
        </article>
      ))}
      <p class="archive-empty hidden" style="display: none;">Няма матэрыялаў у выбранай рубрыцы.</p>
    </div>
  </div>
</Base>

<script>
  (function() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.archive-item');
    buttons.forEach(btn => {
      btn.addEventListener('click', function() {
        buttons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;
        let visibleCount = 0;
        items.forEach(item => {
          if (filter === 'all' || item.dataset.category === filter) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });
        const emptyMsg = document.querySelector('.archive-empty');
        if (emptyMsg) {
          emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
        }
      });
    });
  })();
</script>
