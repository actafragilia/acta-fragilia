---
import Base from '../../layouts/Base.astro';

const articles = [
  {
    slug: 'bankrotstvo-kak-sistema',
    category: 'Эканоміка',
    date: '10.08.2026',
    title: 'Банкротства як сістэма: хто плаціць за крах прадпрыемства',
    excerpt: 'Фінансавы крах кампаніі рэдка застаецца прыватнай справай яе ўладальнікаў. Разбіраем, як даўгі, рашэнні менеджменту і дзяржаўныя механізмы размяркоўваюць страты паміж работнікамі, крэдыорамі і грамадствам.',
  },
  {
    slug: 'novye-religioznye-dvizheniya',
    category: 'Грамадства',
    date: '22.07.2026',
    title: 'Новыя рэлігійныя рухі: паміж асабістым пошукам і сістэмай кантролю',
    excerpt: 'Як адрозніць сусветапоглядную супольнасць ад структуры, у якой давер ператвараецца ў інструмент падпарадкавання: прыкмеы, механізмы і пытанні для праверкі.',
  },
  {
    slug: 'mediinyi-landshaft',
    category: 'Медыя',
    date: '05.07.2026',
    title: 'Медыйны ландшафт: як інфармацыйныя патокі фармуюць карціну рэальнасці',
    excerpt: 'Чаму хуткасць распаўсюджвання інфармацыі не роўная яе дакладнасці і якія прыёмы дапамагаюць чытачу аддзяліць факт ад інтэрпрэтацыі і маніпуляцыі.',
  },
];
---

<Base title="ACTA FRAGILIA — Незалежная журналістыка і аналітыка" lang="by">
  <section class="hero">
    <p class="hero-label">Незалежная журналістыка і аналітыка</p>
    <h1 class="hero-title">ACTA <em>FRAGILIA</em></h1>
    <p class="hero-lead">
      Права, эканоміка, карпаратыўныя канфлікты і грамадскія працэсы — без шуму, з праверкай фактаў і ўвагай да наступстваў.
    </p>
    <div class="hero-tags">
      <span class="tag">Доўгія тэксты</span>
      <span class="tag">Дакументы</span>
      <span class="tag">Расследаванні</span>
    </div>
  </section>

  <section class="latest">
    <h2 class="section-title">Апошнія публікацыі</h2>
    <div class="article-list">
      {articles.map((article) => (
        <article class="article-card">
          <div class="article-meta">
            <span class="article-category">{article.category}</span>
            <time class="article-date">{article.date}</time>
          </div>
          <div class="article-body">
            <h3 class="article-title">
              <a href={`/by/article/${article.slug}`}>{article.title}</a>
            </h3>
            <p class="article-excerpt">{article.excerpt}</p>
            <a href={`/by/article/${article.slug}`} class="read-more">Чытаць поўнасцю →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
