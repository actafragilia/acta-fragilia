---
import Base from '../../layouts/Base.astro';

const articles = [
  {
    slug: 'bankruptcy-as-a-system',
    category: 'Economy',
    date: '10.08.2026',
    title: 'Bankruptcy as a System: Who Pays for Corporate Collapse',
    excerpt: 'The financial collapse of a company rarely remains a private matter of its owners. We examine how debts, management decisions, and state mechanisms distribute losses among employees, creditors, and society.',
  },
  {
    slug: 'new-religious-movements',
    category: 'Society',
    date: '22.07.2026',
    title: 'New Religious Movements: Between Personal Search and Control Systems',
    excerpt: 'How to distinguish a worldview community from a structure where trust becomes an instrument of subordination: signs, mechanisms, and questions for verification.',
  },
  {
    slug: 'media-landscape',
    category: 'Media',
    date: '15.06.2026',
    title: 'Media Landscape: Who Shapes the Agenda',
    excerpt: 'An analysis of media market structure, ownership concentration, and mechanisms of agenda-setting in the context of digital transformation.',
  },
];
---

<Base title="ACTA FRAGILIA — Independent Journalism & Analysis" lang="en">
  <section class="hero">
    <p class="hero-label">Independent Journalism and Analysis</p>
    <h1 class="hero-title">ACTA <em>FRAGILIA</em></h1>
    <p class="hero-lead">
      Law, economics, corporate conflicts, and social processes — without noise, with fact-checking and attention to consequences.
    </p>
    <div class="hero-tags">
      <span class="tag">Long reads</span>
      <span class="tag">Documents</span>
      <span class="tag">Investigations</span>
    </div>
  </section>

  <section class="latest">
    <h2 class="section-title">Latest Publications</h2>
    <div class="article-list">
      {articles.map((article) => (
        <article class="article-card">
          <div class="article-meta">
            <span class="article-category">{article.category}</span>
            <time class="article-date">{article.date}</time>
          </div>
          <div class="article-body">
            <h3 class="article-title">
              <a href={`/en/article/${article.slug}`}>{article.title}</a>
            </h3>
            <p class="article-excerpt">{article.excerpt}</p>
            <a href={`/en/article/${article.slug}`} class="read-more">Read full text →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
