---
import Base from "../../layouts/Base.astro";
---

<Base title="Archive — Acta Fragilia">
  <main class="archive-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/en/">Home</a>
      <span class="breadcrumbs-separator">/</span>
      <span class="breadcrumbs-current">Archive</span>
    </nav>

    <h1>Archive</h1>
    <p class="archive-intro">Complete list of materials.</p>

    <ul class="archive-list">
      <li><a href="/en/article/novyya-religijnyya-ruhi/">New Religious Movements</a></li>
    </ul>
  </main>
</Base>

<style>
  .archive-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
    margin-bottom: 1.5rem;
    padding: 0.5rem 0;
  }
  .breadcrumbs a {
    color: var(--color-link, #005a9c);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs-separator {
    margin: 0 0.4rem;
    color: var(--color-text-muted, #999);
  }
  .breadcrumbs-current {
    color: var(--color-text, #333);
    font-weight: 500;
  }
  .archive-intro {
    color: var(--color-text-muted, #666);
    margin-bottom: 1.5rem;
  }
  .archive-list {
    list-style: none;
    padding: 0;
  }
  .archive-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
  }
  .archive-list a {
    color: var(--color-link, #005a9c);
    text-decoration: none;
  }
  .archive-list a:hover {
    text-decoration: underline;
  }
</style>
