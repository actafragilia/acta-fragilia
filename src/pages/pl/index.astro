---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const articles = (await getCollection('articlesPl'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="ACTA FRAGILIA" lang="pl">

  <header class="hero">
    <div class="hero-grid" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <defs>
          <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="var(--line-strong)" stroke-width="0.8"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="var(--accent)" stroke-width="0.5" opacity="0.15"/>
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="var(--accent)" stroke-width="0.5" opacity="0.15"/>
      </svg>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">Niezależne dziennikarstwo i analiza</p>
      <h1>ACTA <em>FRAGILIA</em></h1>
      <p class="hero-lead">Prawo, ekonomia, konflikty korporacyjne i procesy społeczne — bez szumu, z weryfikacją faktów i uwagą na konsekwencje.</p>
      <div class="hero-meta">
        <span><span class="dot" aria-hidden="true"></span> Długie teksty</span>
        <span><span class="dot" aria-hidden="true"></span> Dokumenty</span>
        <span><span class="dot" aria-hidden="true"></span> Śledztwa</span>
      </div>
      <a href="#latest" class="hero-cta">Czytaj materiały →</a>
    </div>
  </header>

  <section id="latest">
    <div class="section-header">
      <h2>Najnowsze publikacje</h2>
      <span class="line" aria-hidden="true"></span>
    </div>

    <div class="articles-list">
      {articles.map(article => {
        const d = new Date(article.data.date);
        const dateStr = d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
        return (
          <article class="article-card">
            <div class="article-marginalia">
              <a href={`/pl/archive?category=${article.data.category}`} class="article-category">{article.data.category}</a>
              <time class="article-date" datetime={d.toISOString().split('T')[0]}>{dateStr}</time>
            </div>
            <div class="article-body">
              <h3><a href={`/pl/article/${article.slug}`}>{article.data.title}</a></h3>
              <p>{article.data.subtitle}</p>
              <a href={`/pl/article/${article.slug}`} class="article-link">Czytaj w całości →</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>Przeglądaj według tematu</h2>
      <span class="line" aria-hidden="true"></span>
    </div>
    <ul class="category-list home-categories">
      <li><a href="/pl/archive?category=Prawo">Prawo</a> — Analiza ustawodawstwa, praktyki sądowej i kolizji prawnych.</li>
      <li><a href="/pl/archive?category=Ekonomia">Ekonomia</a> — Analiza konfliktów korporacyjnych, upadłości, mechanizmów podatkowych i finansowych.</li>
      <li><a href="/pl/archive?category=Społeczeństwo">Społeczeństwo</a> — Procesy społeczne, instytucje i ich transformacja.</li>
      <li><a href="/pl/archive?category=Media">Media</a> — Przepływy informacyjne, dziennikarstwo i umiejętność korzystania z mediów.</li>
      <li><a href="/pl/archive?category=Analiza Instytucjonalna">Analiza Instytucjonalna</a> — Jak naprawdę działają struktury polityczne, państwowe, korporacyjne i społeczne.</li>
      <li><a href="/pl/archive?category=Konflikt">Konflikt</a> — Spory korporacyjne i gospodarcze w szczegółach.</li>
      <li><a href="/pl/archive?category=Dokument">Dokument</a> — Analiza jednego konkretnego dokumentu z komentarzami.</li>
    </ul>
  </section>
  </Base>