---
const currentPath = Astro.url.pathname;

// Определяем язык из URL
const langMap = {
  'en': { label: 'EN', prefix: '/en' },
  'pl': { label: 'PL', prefix: '/pl' },
  'by': { label: 'BY', prefix: '/by' },
  'ru': { label: 'RU', prefix: '' }
};

// Текущий язык
let currentLang = 'ru';
for (const [lang, info] of Object.entries(langMap)) {
  if (currentPath.startsWith(info.prefix + '/') || (info.prefix === '' && !currentPath.startsWith('/en/') && !currentPath.startsWith('/pl/') && !currentPath.startsWith('/by/'))) {
    currentLang = lang;
    break;
  }
}

// Строим ссылки для каждого языка
const links = Object.entries(langMap).map(([lang, info]) => {
  let href = info.prefix || '/';
  // Если мы не на главной, добавляем путь после префикса
  if (currentPath !== '/' && currentPath !== '/en/' && currentPath !== '/pl/' && currentPath !== '/by/') {
    const suffix = currentPath.replace(/^\/(en|pl|by)/, '');
    href = (info.prefix || '') + suffix;
    // удаляем двойные слэши
    href = href.replace(/\/\//g, '/');
    if (href === '') href = '/';
  }
  return { lang, label: info.label, href, active: lang === currentLang };
});
---

<nav class="lang-switcher">
  {links.map(({ lang, label, href, active }) => (
    <a
      href={href}
      class:list={{ active }}
      aria-current={active ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .lang-switcher a {
    padding: 0.25rem 0.5rem;
    text-decoration: none;
    color: #888;
    border-radius: 4px;
    transition: 0.2s;
  }
  .lang-switcher a:hover {
    color: #222;
    background: #f0f0f0;
  }
  .lang-switcher a.active {
    color: #000;
    background: #e0e0e0;
    font-weight: 600;
  }
  @media (prefers-color-scheme: dark) {
    .lang-switcher a:hover {
      color: #eee;
      background: #333;
    }
    .lang-switcher a.active {
      color: #fff;
      background: #444;
    }
  }
</style>
