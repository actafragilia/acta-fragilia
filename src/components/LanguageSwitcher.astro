---
const currentPath = Astro.url.pathname;

// Языки в нужном порядке: RU, BY, PL, EN
const langMap = [
  { lang: 'ru', label: 'RU', prefix: '' },
  { lang: 'by', label: 'BY', prefix: '/by' },
  { lang: 'pl', label: 'PL', prefix: '/pl' },
  { lang: 'en', label: 'EN', prefix: '/en' }
];

// Определяем текущий язык
let currentLang = 'ru';
for (const entry of langMap) {
  const prefix = entry.prefix;
  if (prefix === '' && !currentPath.startsWith('/en/') && !currentPath.startsWith('/pl/') && !currentPath.startsWith('/by/')) {
    currentLang = 'ru';
    break;
  }
  if (prefix !== '' && currentPath.startsWith(prefix + '/')) {
    currentLang = entry.lang;
    break;
  }
}

// Строим ссылки для каждого языка
const links = langMap.map(({ lang, label, prefix }) => {
  let href = prefix || '/';
  // Если мы не на главной, добавляем путь после префикса
  if (currentPath !== '/' && currentPath !== '/en/' && currentPath !== '/pl/' && currentPath !== '/by/') {
    const suffix = currentPath.replace(/^\/(en|pl|by)/, '');
    href = (prefix || '') + suffix;
    // удаляем двойные слэши
    href = href.replace(/\/\//g, '/');
    if (href === '') href = '/';
  }
  return { lang, label, href, active: lang === currentLang };
});
---

<nav class="lang-switcher">
  {links.map(({ lang, label, href, active }) => (
    <a
      href={href}
      class:list={{ active }}
      aria-current={active ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .lang-switcher a {
    padding: 0.25rem 0.5rem;
    text-decoration: none;
    color: #888;
    border-radius: 4px;
    transition: 0.2s;
  }
  .lang-switcher a:hover {
    color: #222;
    background: #f0f0f0;
  }
  .lang-switcher a.active {
    color: #000;
    background: #e0e0e0;
    font-weight: 600;
  }
  @media (prefers-color-scheme: dark) {
    .lang-switcher a:hover {
      color: #eee;
      background: #333;
    }
    .lang-switcher a.active {
      color: #fff;
      background: #444;
    }
  }
</style>
